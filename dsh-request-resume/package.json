{
  "name": "@undernapse/dsh-request-resume",
  "version": "0.2.0",
  "private": true,
  "description": "Watches model routes and continues every conversation stuck on one: one availability probe per provider and model, then Continue for all of them",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Undernapse/dsh-plugins.git",
    "directory": "dsh-request-resume"
  },
  "type": "module",
  "main": "index.js",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./index.js",
    "./lib/watch.js": "./lib/watch.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "lib/watch.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node --test test/"
  },
  "license": "MIT"
}
